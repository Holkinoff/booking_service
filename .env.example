# PostgreSQL
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/booking_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# App Settings
BOOKING_MIN_MINUTES_BEFORE_SLOT=60
NOTIFICATION_HOURLY_LIMIT=3
